# Leaders of the SME after the coup.
#
# NOTE THE CASE: spriteType, not SpriteType. Vanilla writes it lowercase
# everywhere and so do the CRA and WRD files that are known to work in game.
#
# Portraits are .png at 156x210, with a 67x67 _small beside each, matching the
# CRA and WRD portraits already in this mod.

spriteTypes = {
